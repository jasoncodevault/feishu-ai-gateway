+func TestParseClaudeUsageReport_PrintFormat(t *testing.T) {
+	loc := mustLoadLocation(t, "UTC")
+	now := time.Date(2026, time.July, 8, 10, 15, 0, 0, loc)
+	text := strings.TrimSpace(`
+You are currently using your subscription to power your Claude Code usage
+
+Current session: 45% used · resets Jul 8, 1:59pm (UTC)
+Current week (all models): 58% used · resets Jul 13, 2:59pm (UTC)
+Current week (Fable): 84% used · resets Jul 13, 2:59pm (UTC)
+`)
+
+	report, err := parseClaudeUsageReport(text, now)
+	if err != nil {
+		t.Fatalf("parseClaudeUsageReport returned error: %v", err)
+	}
+	if len(report.Buckets) != 1 || len(report.Buckets[0].Windows) != 3 {
+		t.Fatalf("unexpected bucket layout: %+v", report.Buckets)
+	}
+	session := report.Buckets[0].Windows[0]
+	if session.UsedPercent != 45 || session.ResetAtUnix == 0 {
+		t.Fatalf("bad session window: %+v", session)
+	}
+	week := report.Buckets[0].Windows[1]
+	if week.UsedPercent != 58 || week.ResetAtUnix == 0 {
+		t.Fatalf("bad week window: %+v", week)
+	}
+	fable := report.Buckets[0].Windows[2]
+	if fable.Name != "Current week (Fable)" || fable.UsedPercent != 84 || fable.ResetAtUnix == 0 {
+		t.Fatalf("bad fable window: %+v", fable)
+	}
+}
