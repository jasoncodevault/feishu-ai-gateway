+func (a *Agent) runClaudeUsagePrint(ctx context.Context) (string, error) {
+	cmdPath, cmdPrefixArgs := a.usageProbeCommand()
+	cmdArgs := append(append([]string{}, cmdPrefixArgs...), "--print", "/usage")
+	cmd := exec.CommandContext(ctx, cmdPath, cmdArgs...)
+	if workDir := a.usageProbeWorkDir(); workDir != "" {
+		cmd.Dir = workDir
+	}
+	env := filterEnv(os.Environ(), "CLAUDECODE")
+	env = append(env, "DISABLE_TELEMETRY=true")
+	env = append(env, "DISABLE_COST_WARNINGS=true")
+	if extra := a.usageProbeEnv(); len(extra) > 0 {
+		env = core.MergeEnv(env, extra)
+	}
+	cmd.Env = env
+	out, err := cmd.CombinedOutput()
+	text := normalizeClaudeUsageText(string(out))
+	if err != nil {
+		if screenErr := detectClaudeUsageOutputError(text, ""); screenErr != nil {
+			return "", screenErr
+		}
+		return "", fmt.Errorf("claudecode: Claude Code /usage print failed: %w", err)
+	}
+	if !usageReady(text) {
+		if screenErr := detectClaudeUsageOutputError(text, ""); screenErr != nil {
+			return "", screenErr
+		}
+		return "", fmt.Errorf("claudecode: Claude Code /usage print did not include a usage panel")
+	}
+	return text, nil
+}
