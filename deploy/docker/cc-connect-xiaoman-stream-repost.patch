+func (cs *claudeSession) handleStreamEvent(raw map[string]any) {
+	event, ok := raw["event"].(map[string]any)
+	if !ok {
+		return
+	}
+	eventType, _ := event["type"].(string)
+	if eventType == "message_start" {
